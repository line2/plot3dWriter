{
  "version": 6,
  "configurePresets": [
    {
      "name": "local",
      "hidden": true,
      "inherits": [
        "clangcl-ninja-base",
        "vcpkg"
      ],
      "cacheVariables": {
        "CMAKE_PROJECT_TOP_LEVEL_INCLUDES": "${sourceDir}/cmake/plot3d_vcpkg_vtk_compile_tools.cmake;${sourceDir}/cmake/local_compile_commands_sync.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "ENABLE_VTK": "ON"
      },
      "environment": {
        "VCPKG_ROOT": "D:/vcpkg"
      }
    },
    {
      "name": "Debug",
      "inherits": [
        "dbg",
        "local"
      ]
    },
    {
      "name": "Release",
      "inherits": [
        "rel",
        "local"
      ]
    }
  ]
}
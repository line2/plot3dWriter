{
  "version": 5,
  "configurePresets": [
    {
      "name": "ninja-msvc-debug-local",
      "inherits": "ninja-msvc-debug",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl"
      },
      "environment": {
        "VCPKG_ROOT": "D:/vcpkg"
      }
    },
    {
      "name": "ninja-msvc-release-local",
      "inherits": "ninja-msvc-release",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl"
      },
      "environment": {
        "VCPKG_ROOT": "D:/vcpkg"
      }
    }
  ]
}
